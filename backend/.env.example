OPENAI_API_KEY=

# Deepgram's api_key + llm_proxy_secret, and the deployment's
# PUBLIC_BASE_URL, do NOT live here -- they moved to normalized Postgres
# tables (voice_provider_credentials, deployment_settings; see
# assistant/db.py and config_store.set_voice_secret/set_public_base_url),
# cached the same way as every other config_store value. Unlike
# OPENAI_API_KEY above (a genuine cross-cutting secret read by rag.py/
# embeddings.py/ingest.py too, so it stays an env var), these three are
# voice-specific and safe to manage entirely through the DB. Seed them once:
#
#   python -c "
#   from assistant import db; db.init_db()
#   from assistant import config_store
#   config_store.set_voice_secret('deepgram', api_key='...', llm_proxy_secret='...')
#   config_store.set_public_base_url('https://your-public-url')
#   "
#
# then edit them directly in Postgres from then on (voice_provider_credentials,
# deployment_settings), same as config_settings.

# Chat history + document library storage (assistant/db.py). Defaults to
# this same value if unset, so it's only needed here for clarity/override.
# docker-compose.yml sets this to point at the app-db service instead.
DATABASE_URL=postgresql://docassist:docassist@localhost:5432/docassist

# Postgres connection pool size (assistant/db.py). Defaults shown -- bump
# DB_POOL_MAX_SIZE if running uvicorn with multiple workers.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Live app-config cache (assistant/config_store.py). Defaults to this same
# value if unset. docker-compose.yml sets this to point at the redis service
# instead.
REDIS_URL=redis://localhost:6379/0

# Auth (assistant/auth.py). REQUIRED -- the app refuses to start without it.
#
# JWT_SECRET signs every login token -- generate a real one with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"` and never commit
# the real value. Rotating it logs every current user out (all existing
# tokens stop verifying).
JWT_SECRET=

# Everything below this line is only a SEED value, applied once to
# config_settings on first-ever startup (see config_store.seed_defaults) --
# not required, and changing it here does nothing after that first boot.
# From then on, edit the live value directly in Postgres (config_settings,
# matching category/key below) instead.

# Shared password for the SEPARATE admin app (frontend/admin_app.py) -- logs
# in via POST /admin/login, issuing its own admin JWT. Never entered
# anywhere in the chatbot. Seeds config_settings' auth/admin_password.
ADMIN_PASSWORD=

# How long a login stays valid before re-login is required. Seed values for
# config_settings' auth/jwt_expiry_days and auth/admin_jwt_expiry_hours.
JWT_EXPIRY_DAYS=7
ADMIN_JWT_EXPIRY_HOURS=12
