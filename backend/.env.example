OPENAI_API_KEY=

# Chat history + document library storage (assistant/db.py). Defaults to
# this same value if unset, so it's only needed here for clarity/override.
# docker-compose.yml sets this to point at the app-db service instead.
DATABASE_URL=postgresql://docassist:docassist@localhost:5432/docassist

# Postgres connection pool size (assistant/db.py). Defaults shown -- bump
# DB_POOL_MAX_SIZE if running uvicorn with multiple workers.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Live app-config cache (assistant/config_store.py). Defaults to this same
# value if unset. docker-compose.yml sets this to point at the redis service
# instead.
REDIS_URL=redis://localhost:6379/0

# Auth (assistant/auth.py). Both REQUIRED -- there is no safe default, the
# app refuses to start without them.
#
# JWT_SECRET signs every login token -- generate a real one with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"` and never commit
# the real value. Rotating it logs every current user out (all existing
# tokens stop verifying).
JWT_SECRET=

# A single shared password required, in addition to being logged in, for
# every document upload or delete (see api.py's /ingest and
# DELETE /documents/{filename}) -- checked fresh on each call, never cached
# in the JWT or "unlocked" for a session.
ADMIN_PASSWORD=

# How long a login stays valid before the user has to log in again.
JWT_EXPIRY_DAYS=7
